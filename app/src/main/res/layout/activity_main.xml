<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp"
        tools:context=".MainActivity">

        <TextView
            android:id="@+id/tvTieuDe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tieu_de"
            android:textSize="20dp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/edtSo1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margintop="16dp"
            android:text="@string/goi_y_1"
            android:inputType="numberDecimal"
            android:padding="14dp"
            app:layout_constraintTop_toBottomOf="@id/tvTieuDe"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/edtSo2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margintop="16dp"
            android:text="@string/goi_y_2"
            android:inputType="numberDecimal"
            android:padding="14dp"
            app:layout_constraintTop_toBottomOf="@id/edtSo1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <RadioGroup
            android:id="@+id/rgPhep"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margintop="16dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/edtSo2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <RadioButton android:id="@+id/rbCong"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cộng (+)"
                android:checked="true"/>
            <RadioButton android:id="@+id/rbTru"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Trừ (-)"/>
            <RadioButton android:id="@+id/rbNhan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Nhân (*)"/>
            <RadioButton android:id="@+id/rbChia"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Chia (/)"/>
        </RadioGroup>
        
        <CheckBox
            android:id="@id+/cbTron"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/goi_y_1"


    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>